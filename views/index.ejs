<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta charset="UTF-8">
<title>Nitaq</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@400;600;700&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600&display=swap" rel="stylesheet">

<link rel="stylesheet" href="/style.css">
</head>

<body>


<!-- WAVY LINES -->
<svg class="light-lines" viewBox="0 0 1440 600" preserveAspectRatio="none">
    <path d="M0,300 C200,200 400,400 600,300 800,200 1000,400 1200,300 1400,200 1600,400 1800,300"
    stroke="rgba(255,255,255,0.25)"
    stroke-width="2"
    fill="none"/>
</svg>

<!-- NAVBAR -->
<nav class="navbar">
    <div class="logo">Nitaq</div>

    <div class="nav-links">
        <a href="#">المنتج</a>
        <a href="#">الأمان</a>
        <a href="#">تواصل معنا</a>
    </div>

    <div class="auth-menu">
        <button class="nav-btn" onclick="toggleAuthMenu()">
            تسجيل الدخول
        </button>

        <div class="auth-dropdown" id="authDropdown">
            <a href="/login">تسجيل الدخول</a>
            <a href="/register">إنشاء حساب</a>
        </div>
    </div>
</nav>

<!-- HERO -->
<section class="hero">

    <div class="release-badge">
        <span class="status-dot"></span>
        <span class="release-text">الإصدار 1.0 متاح الآن</span>
    </div>

    <h1>
        العالم الجديد<br>
        للتوثيق الرقمي
    </h1>

    <p>
        إصدار وإدارة والتحقق من الوثائق الرسمية بيقين تشريعي،
        مدعوم بالهوية الرقمية السيادية والخدمات الحكومية الآمنة.
    </p>

    <div class="buttons">

 <a href="/register" class="btn primary">
        ابدأ الآن
</a>

        <a href="/login" class="btn secondary">تسجيل الدخول</a>

    </div>

</section>

<footer class="footer">
    <p class="footer-text">مدعوم بواسطة</p>
    <div class="humain-btn">HUMAIN</div>
</footer>

<!-- ===== JS ===== -->

<script>
function toggleAuthMenu() {
    const menu = document.getElementById("authDropdown");
    if (menu) {
        menu.classList.toggle("show");
    }
}

window.addEventListener("click", function(e){
    const dropdown = document.getElementById("authDropdown");
    if (!dropdown) return;

    const isMenuButton = e.target.closest(".nav-btn");
    const isInsideDropdown = e.target.closest(".auth-dropdown");

    if (!isMenuButton && !isInsideDropdown) {
        dropdown.classList.remove("show");
    }
});
</script>

</body>
</html>